{
  "name": "tunnel-to-my-dash-desktop",
  "productName": "Tunnel to My Dash",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Tunnel to My Dash",
  "author": "DeSynkro",
  "license": "GPL-3.0-only",
  "desktopName": "tunnel-to-my-dash.desktop",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --no-warnings --test src/main/credential-match.test.ts src/main/private-url.test.ts",
    "check": "npm run typecheck && npm run test:unit && npm run build",
    "start": "npm run build && ELECTRON_CACHE=../.cache/electron electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --config ../platforms/linux/electron-builder.yml",
    "dist:windows": "npm run build && electron-builder --win portable --x64 --config ../platforms/windows/electron-builder.yml",
    "dist": "npm run dist:linux"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
